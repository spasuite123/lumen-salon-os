# Copy to .env and fill in from your Supabase project (Settings -> API).
# Leave blank to run in DEMO MODE (local mock data, no backend needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key (pk_test_... or pk_live_...).
# Safe to expose in the browser. Leave blank to simulate payments in demo mode.
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe secret key — set this in Supabase Edge Function secrets, NOT here.
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# STRIPE_SECRET_KEY=
